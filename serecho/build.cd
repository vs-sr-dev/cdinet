options: -s

define
	album		"SerEcho"
	publisher	"CDI-Homebrew-Toolchain"
	preparer	"CDI-Homebrew-Toolchain"

	volume	"SerEcho"	in	"DISK/SERECHO.CDI"

	copyright	file	Copyright	from "BUILD/COPYRGHT.TXT"
	abstract	file	Abstract	from "BUILD/ABSTRACT.TXT"
	biblio		file	Biblio		from "BUILD/BIBLIOGR.TXT"
	message							from "BUILD/MESSAGE.TXT"

	application file	Echo      from "BUILD/SERECHO"

{
	"COPYRGHT.TXT"	protection 0x555	from	Copyright
	"ABSTRACT.TXT"	protection 0x555	from	Abstract
	"BIBLIOGR.TXT"	protection 0x555	from	Biblio
	"cdi_serecho"     protection 0x555	from	Echo
}
